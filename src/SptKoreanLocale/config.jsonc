{
  // 게임 DB locale 의 한국어를 lang/*.json 사전으로 덮어쓴다.
  // 끄면 아무것도 바꾸지 않고 사전 셈만 로그에 남긴다.
  "modEnabled": true,

  // 덮어쓸 게임 locale 코드. SPT 의 한국어는 kr 이다(locales/global/kr.json).
  // 서버 웹 화면의 ko 와 다르다 — 그쪽은 locales/web/ 소관이고 이 모드와 무관하다.
  // 없는 코드를 적으면 서버가 조용히 en 을 돌려주는데, 그때는 아무것도 하지 않고 오류를 남긴다.
  "locale": "kr",

  // 참이면 이미 있는 열쇠만 덮어쓴다. 사전 오타나 빠진 모드를 경고로 알려 준다.
  // 새 열쇠를 일부러 넣어야 할 때만 끈다.
  "onlyExistingKeys": true,

  // 참이면 이미 한글이 들어 있는 값은 건드리지 않는다.
  // 거짓(기본)이면 덮어쓰되 몇 개를 덮었는지 로그에 남긴다.
  "skipAlreadyKorean": false,

  // 참(기본)이면 지금 값에 붙어 있는 꾸밈을 그대로 두고 글자만 바꾼다.
  // 아이템 이름·약칭에는 다른 모드가 색 태그(<b><color=#RRGGBB>…</color></b>)와 ● 표시를 덧댄다
  // — 바닐라 한국어 이름에도 붙는다. 우리 변환기는 맨 끝에 돌기 때문에 값을 통째로 쓰면
  // 사전에 적은 아이템만 색과 ● 가 사라져 인벤토리에서 따로 보인다(2026-11-09 실측).
  // 꺼야 할 이유가 생기면 끄되, 그때는 사전 값에 색을 직접 적어야 하고 등급 색이 고정된다.
  "preserveDecoration": true,

  // 항목 하나하나를 로그에 적는다. 사전을 새로 쓸 때만 켠다.
  "debug": false
}
