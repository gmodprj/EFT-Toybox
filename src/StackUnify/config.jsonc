{
  // false 면 데이터베이스를 건드리지 않는다.
  "ModEnabled": true,

  // 바꾼 항목을 한 줄씩 기록한다. 수백 줄이 될 수 있다.
  "Debug": false,

  // 바꾸지 않고 "바꿀 것"만 기록한다. 다른 모드가 지금 어떤 값을 넣어 뒀는지 먼저 볼 때 쓴다.
  "ReportOnly": false,

  // 내가 정한 값과 이미 들어 있던 값이 다른 항목 수를 요약에 적는다.
  // 그 수가 곧 "다른 모드가 건드려 둔 항목 수"다.
  "ReportOverridden": true,

  // 구경 이름 -> 최대 스택. 탄약에 적용한다. 이름은 게임 값 그대로다.
  //
  // 비어 있으면 아무것도 바꾸지 않는다. 지금 들어 있는 값을 먼저 보고 채우는 것이 맞다 —
  // "ReportOnly": true 로 한 번 띄우면 어디가 겹치는지 로그에 나온다.
  //
  // 이 설치본에서 쓰이는 이름 보기:
  //   권총   Caliber9x18PM Caliber9x19PARA Caliber9x21 Caliber9x33R Caliber57x28
  //          Caliber46x30 Caliber1143x23ACP Caliber762x25TT
  //   소총   Caliber545x39 Caliber556x45NATO Caliber762x35 Caliber762x39 Caliber68x51
  //   지정사수 Caliber762x51 Caliber762x54R
  //   산탄   Caliber12g Caliber20g
  //   대구경 Caliber127x55 Caliber86x70 Caliber366TKM
  //   유탄   Caliber40x46 Caliber40mmRU Caliber26x75
  //
  // 보기 (주석을 벗기고 쓴다):
  //   "Caliber9x19PARA": 150,
  //   "Caliber556x45NATO": 180,
  //   "Caliber12g": 60
  "StackByCaliber": {},

  // 아이템 id -> 최대 스택. 구경 규칙보다 우선하고, 탄약이 아닌 것에도 쓸 수 있다.
  //
  // 보기 (화폐. 지금은 BarterItemsStacks 가 주인이다):
  //   "5449016a4bdc2d6f028b456f": 50000000,   // 루블
  //   "5696686a4bdc2da3298b456a": 50000000,   // 달러
  //   "569668774bdc2da2298b4568": 50000000,   // 유로
  //   "5d235b4d86f7742e017bc88a": 5000        // GP 코인
  "StackByItemId": {},

  // 건드리지 않을 아이템 id. 구경 규칙에 걸려도 넘어간다.
  "ExcludedItemIds": []
}
