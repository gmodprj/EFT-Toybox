{
  // false 면 패치를 걸지 않는다. N 은 게임이 하던 대로(여닫이 중 첫 번째 하나만) 동작한다.
  "enabled": true,

  // 이 시간(초)을 넘겨 누르면 "길게" 로 쳐서 휠이 뜬다. 0.05 ~ 2.0 밖은 눌러 쓴다.
  "longPressSeconds": 0.25,

  // 짧게 눌렀을 때 여닫을 것 — nightvision · faceshield · first.
  "defaultTarget": "nightvision",

  // 휠에서 이 길이 미만으로 기울이면 아무 것도 고르지 않는다(가운데에 둔 채 떼면 취소).
  "wheelDeadZone": 0.2,

  // 휠 위 가상 커서가 마우스에 얼마나 민감한지. 0.01 ~ 2.0 밖은 눌러 쓴다.
  // 커서는 게임 시점 축이 아니라 날 마우스 움직임에서 방향을 받으므로,
  // 게임 안 시점 감도와 따로 맞춰야 한다. 끝까지 안 가면 올리고, 너무 튀면 내린다.
  "mouseSensitivity": 0.15,

  // 게임 제스처 휠의 항목 템플릿을 복제해 쓴다.
  // 기본은 false 다 — 복제해 봤더니 제스처용 아이콘(엄지)과 좁은 글자칸이 같이 딸려 와
  // 이름이 세로로 한 글자씩 쪼개지고 보기 흉했다(실측). 우리가 그린 쪽이 낫다.
  "useGameWheelSkin": false,

  // 힌지로 여닫이가 생긴 헬멧 자신(바이저)도 휠 항목에 넣는다.
  // 끄면 그 헬멧에서 바이저를 N 으로 여닫을 수 없게 된다.
  "includeHelmetVisor": true,

  // COTI 수정키가 눌린 N 은 COTI 에 넘긴다. 남이 먼저 쓰던 입력이다.
  "standDownForCoti": true
}
