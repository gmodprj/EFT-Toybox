{
  // false 로 두면 이 모드는 아무것도 바꾸지 않는다. 서버를 다시 켜야 적용된다.
  // 꺼져 있어도 분류 목록(discovered-categories.json)은 계속 내놓는다.
  "ModEnabled": true,

  // 칸마다 몇 개가 늘었는지 기록한다. 문제를 볼 때만 켠다.
  "Debug": false,

  // 분류별 on/off. 켠 분류만 칸 필터를 넓힌다.
  //
  // 규칙: 어떤 칸이 켜진 분류의 부품을 하나라도 받고 있으면, 그 칸에 같은 분류의 부품을 모두 넣는다.
  // 칸이 원래 받던 다른 분류는 그대로 둔다. 넓히기만 하고 좁히지 않는다.
  //
  // 여기 적지 않은 분류는 꺼진 것으로 본다. 이 설치본에 어떤 분류가 있는지는 서버를 한 번 켜면
  // 같은 폴더의 discovered-categories.json 에 전부 나온다(분류 이름 + 그 분류의 아이템 수).
  // 서버 웹 페이지의 모드 설정에서 스위치로 켜고 끌 수도 있다.
  //
  // 아래는 처음 설치했을 때의 보기다. 전부 꺼진 상태로 두었으니 원하는 것만 켜라.
  "Categories": {
    "AssaultScope": false,
    "OpticScope": false,
    "SpecialScope": false,
    "Collimator": false,
    "CompactCollimator": false,
    "IronSight": false,
    "Mount": false,
    "TacticalCombo": false,
    "AuxiliaryMod": false,
    "Bipod": false,
    "Foregrip": false,
    "Silencer": false,
    "FlashHider": false,
    "MuzzleCombo": false,
    "Handguard": false,
    "Stock": false,
    "PistolGrip": false,
    "Receiver": false,
    "Barrel": false,
    "Gasblock": false,
    "Charge": false,
    "Launcher": false,
    "Magazine": false,
    "CylinderMagazine": false,
    "SpringDrivenCylinder": false
  },

  // 맨 끝(int.MaxValue)에서 칸 넓히기를 한 번 더 한다.
  //
  // 우선순위를 적지 않은 서버 모드는 기본값이 int.MaxValue 라 PostLoad 보다 **뒤에** 돈다.
  // 그런 모드가 칸 필터를 통째로 다시 쓰면 우리가 넓힌 것이 사라진다 — 2026-11-07 실측:
  // ECOTI 의 ThermalRiserCompatibility 가 열화상 라이저의 조준경 목록을 갈아 끼웠다.
  "LateSweep": true,

  // 아이템별 씨앗 분류. 그 아이템의 칸에 이 분류들을 "이미 받고 있는 것" 으로 쳐 준다.
  //
  // 이 모드는 칸이 **이미 받고 있는** 분류만 넓힌다(없던 분류를 지어 넣지 않는다). 그래서 위의
  // ECOTI 처럼 어떤 분류를 0개로 만들어 버리는 모드가 있으면 늦은 쓸기로도 그 칸은 못 넓힌다 —
  // 순서가 아니라 규칙이 막는 자리다. 그럴 때만 사람이 씨앗을 적는다.
  //
  // 적은 아이템에만 닿는다. 분류 스위치가 상위라 Categories 에서 꺼져 있으면 무시된다.
  // 아래 둘은 ECOTI 의 TR-1 열화상 라이저 2색이다 — COTI 가 지운 세 분류를 되돌린다.
  // 주의: COTI 가 고른 목록 밖의 조준경은 끼워져도 열화상이 안 나올 수 있다(메시가 10개다).
  "SeedCategories": {
    "6ad3016bab020957abb6ca3b": ["Collimator", "AssaultScope", "SpecialScope"],
    "6ad408a96bf1f761d970a4ff": ["Collimator", "AssaultScope", "SpecialScope"]
  },

  // 건드리지 않을 칸 이름. 대소문자는 가리지 않는다.
  // 예: ["mod_magazine"] 로 두면 탄창 칸은 분류가 켜져 있어도 그대로 둔다.
  "ExcludedSlotNames": [],

  // 부품에 달린 하위 칸까지 넓힐지. 끄면 무기 본체의 칸만 넓힌다.
  // 마운트 위에 조준경을 올리는 조합은 이것이 켜져 있어야 열린다.
  "IncludeAttachmentSlots": true,

  // 약실(Chambers)이 받는 탄을 넓힌다 — All In Weapon 의 FckChambers 자리다.
  // 약실은 부품 칸이 아니라 Chambers 에 들어 있어 위의 분류 스위치가 닿지 않는다. 그래서 따로 둔다.
  // 그 약실이 이미 받던 분류(거의 다 Ammo)의 탄을 전부 넣는다 — 모든 총기의 약실에 모든 탄종.
  // 탄창은 건드리지 않으므로, 다른 구경의 탄은 약실에 한 발씩 물리는 것까지다.
  "RelaxChambers": true,

  // 약실을 넓히지 않을 총기 아이템 id. 비워두면 구경 목록으로만 거른다.
  "ExcludedChamberWeaponIds": [],

  // 약실을 넓히지 않을 구경(ammoCaliber). 아이템 id 보다 오래 간다 — 모드가 더한 총도 걸린다.
  // 기본값은 유탄발사기 셋과 신호권총이다. 소총탄이 들어갈 자리가 아니다.
  //   Caliber40x46  FN40GL · M203
  //   Caliber40mmRU GP-25
  //   Caliber30x29  AGS-30
  //   Caliber26x75  ZiD SP-81 신호권총
  // 이것까지 열고 싶으면 비워 둔다(RPG 류는 애초에 Rocket 분류라 로켓만 들어간다).
  "ExcludedChamberCalibers": ["Caliber40x46", "Caliber40mmRU", "Caliber30x29", "Caliber26x75"]
}
