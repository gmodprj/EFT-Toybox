<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SptTeamManager.Server</AssemblyName>
    <RootNamespace>pitTeam.Server</RootNamespace>
    <Version>1.0.0</Version>
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SptReferenceRoot Condition="'$(SptReferenceRoot)' == ''">$(MSBuildProjectDirectory)/refs/4.1.0</SptReferenceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/FriendlyEncounterPenaltyPolicy.cs" Link="Shared/FriendlyEncounterPenaltyPolicy.cs" />
    <Compile Include="../shared/PmcKarmaPolicy.cs" Link="Shared/PmcKarmaPolicy.cs" />
    <Compile Include="../shared/SelfDeterminationPolicy.cs" Link="Shared/SelfDeterminationPolicy.cs" />
    <Compile Include="../shared/GiveGearInvitePolicy.cs" Link="Shared/GiveGearInvitePolicy.cs" />
    <Compile Include="../shared/ProfileRosterPolicy.cs" Link="Shared/ProfileRosterPolicy.cs" />
    <Compile Include="../shared/FriendListMergePolicy.cs" Link="Shared/FriendListMergePolicy.cs" />
    <Compile Include="../shared/ProfileMemberLookup.cs" Link="Shared/ProfileMemberLookup.cs" />
    <Compile Include="../shared/SpawnGearPolicy.cs" Link="Shared/SpawnGearPolicy.cs" />
    <Compile Include="../shared/RaidOutcomePolicy.cs" Link="Shared/RaidOutcomePolicy.cs" />
    <Compile Include="../shared/FollowerAiProfilePolicy.cs" Link="Shared/FollowerAiProfilePolicy.cs" />
    <Compile Include="../shared/RaidReceiptKeyPolicy.cs" Link="Shared/RaidReceiptKeyPolicy.cs" />
    <Compile Include="../shared/WornGearLossPolicy.cs" Link="Shared/WornGearLossPolicy.cs" />
    <Compile Include="../shared/RaidProtectionReleasePolicy.cs" Link="Shared/RaidProtectionReleasePolicy.cs" />
    <Compile Include="../shared/ProfileMemberUpdatePolicy.cs" Link="Shared/ProfileMemberUpdatePolicy.cs" />
    <Compile Include="../shared/AutoJoinRosterPolicy.cs" Link="Shared/AutoJoinRosterPolicy.cs" />
    <Compile Include="../shared/StashRevalidationPolicy.cs" Link="Shared/StashRevalidationPolicy.cs" />
    <Compile Include="../shared/TransferJournalPolicy.cs" Link="Shared/TransferJournalPolicy.cs" />
    <Compile Include="../shared/ProfileMemberOperationPolicy.cs" Link="Shared/ProfileMemberOperationPolicy.cs" />
    <Compile Include="../shared/ProfileViewPolicy.cs" Link="Shared/ProfileViewPolicy.cs" />
    <Compile Include="../shared/TransferEntryClosePolicy.cs" Link="Shared/TransferEntryClosePolicy.cs" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptReferenceRoot)/SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptReferenceRoot)/SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptReferenceRoot)/SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptReferenceRoot)/SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\" />
    <None Remove="refs\**\*" />
  </ItemGroup>
  <Target Name="ValidateSptReferences" BeforeTargets="ResolveReferences">
    <ItemGroup>
      <RequiredSptReference Include="$(SptReferenceRoot)/SPTarkov.Common.dll" />
      <RequiredSptReference Include="$(SptReferenceRoot)/SPTarkov.DI.dll" />
      <RequiredSptReference Include="$(SptReferenceRoot)/SPTarkov.Server.Core.dll" />
      <RequiredSptReference Include="$(SptReferenceRoot)/SemanticVersioning.dll" />
    </ItemGroup>
    <Error
      Condition="!Exists('%(RequiredSptReference.Identity)')"
      Text="Required SPT 4.1.0 server reference was not found: %(RequiredSptReference.Identity)"
    />
    <!-- Compile against the oldest supported SPT patch, not the installed runtime. -->
    <ItemGroup>
      <SptAssemblyReference Include="@(RequiredSptReference)" Exclude="$(SptReferenceRoot)/SemanticVersioning.dll" />
    </ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(SptAssemblyReference)">
      <Output TaskParameter="Assemblies" ItemName="SptReferenceIdentity" />
    </GetAssemblyIdentity>
    <Error
      Condition="'%(SptReferenceIdentity.Version)' != '4.1.0.0'"
      Text="SPT 4.1.x compatibility requires 4.1.0.0 compile references. %(SptReferenceIdentity.Identity) is %(SptReferenceIdentity.Version)."
    />
  </Target>
</Project>
