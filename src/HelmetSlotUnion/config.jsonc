{
  // false 로 두면 이 모드는 아무것도 바꾸지 않는다. 서버를 다시 켜야 적용된다.
  "ModEnabled": true,

  // 칸마다 무엇이 몇 개로 늘었는지 한 줄씩 기록한다. 문제를 볼 때만 켠다.
  "Debug": false,

  // mod_equipment 와 mod_equipment_000·001·002… 를 한 묶음으로 본다.
  // 칸 번호의 뜻이 헬멧마다 달라서(Ops-Core FAST 는 001 이 RAC 헤드셋, 002 가 SLAAP 방탄판)
  // 켜면 헤드셋 자리에 방탄판이 들어가는 식의 조합까지 열린다. 기본은 꺼짐.
  "MergeEquipmentSlots": false,

  // 헬멧·헬멧 파츠끼리 서로를 막는 ConflictingItems 를 지운다.
  // 칸 필터만 넓히면 "★ FAST FS 과 ★ SCRA 아이템은 동시에 장착할 수 없습니다" 같은
  // 메시지가 그대로 남는다. 그 제한이 여기에 들어 있다.
  // 헤드셋·안면 보호구처럼 범위 밖을 가리키는 항목은 그대로 둔다(착용 조합 쪽 이야기라
  // Less Restricting Headwear 가 맡는다).
  "RemoveAttachmentConflicts": true,

  // 위보다 센 선택지. 헬멧·헬멧 파츠의 ConflictingItems 를 통째로 비운다.
  // 범위 밖 항목까지 사라져 다른 모드와 부딪힐 수 있다. 기본은 꺼짐.
  "RemoveAllConflictsOnAttachments": false,

  // 총기·총기 파츠끼리 서로를 막는 ConflictingItems 를 지운다.
  // 칸 필터는 건드리지 않는다 — 넓히는 것은 SlotCategoryRelax 같은 다른 모드가 하고,
  // 넓힌 뒤에도 남는 "★ MBUS 가늠쇠과 ★ TR-1 아이템은 동시에 장착할 수 없습니다" 를 푼다.
  "RemoveWeaponAttachmentConflicts": true,

  // 위보다 센 선택지. 총기·총기 파츠의 ConflictingItems 를 통째로 비운다.
  // 탄약처럼 범위 밖 항목까지 사라진다. 기본은 꺼짐.
  "RemoveAllConflictsOnWeaponAttachments": false,

  // 총기 충돌 정리에서 건드리지 않을 분류(부모) id. 어느 쪽에 있든 그 항목은 남는다.
  // 기본값은 탄창·장전 손잡이다. 그 둘이 거는 제한은 모양이 아니라 구경 이야기라서
  // (AXMC .338 볼트에 7.62 총열을 끼우는 식) 지우면 총이 성립하지 않는다.
  "WeaponConflictExcludedCategoryIds": ["5448bc234bdc2d3c308b4569", "55818a6f4bdc2db9688b456b"],

  // 건드리지 않을 총기 아이템 id. 예: ["5447a9cd4bdc2dbd208b4567"]
  "ExcludedWeaponIds": [],

  // 위 두 패스(헬멧 범위·총기 범위)에서 걸러지지 않고 남은 ConflictingItems 를 전부 지운다.
  // 안면 보호구↔헬멧, 헤드셋↔헬멧, 헬멧 쪽에서만 닿는 마운트↔기계식 조준기처럼 두 범위에
  // 걸쳐 있는 것들이 여기서 풀린다. 위의 WeaponConflictExcludedCategoryIds(탄창·장전 손잡이)는
  // 여기서도 남는다 — 그것까지 지우면 구경이 섞인 총이 만들어진다.
  "RemoveRemainingConflicts": true,

  // 건드리지 않을 칸 이름. 대소문자는 가리지 않는다.
  // helmet_top·helmet_back 은 헬멧에 내장된 방탄판 자리다(36종). 여기를 합치면
  // 아무 헬멧에 아무 방탄판을 넣을 수 있어 방어력이 크게 달라진다. 그대로 두고 싶으면
  // ["helmet_top", "helmet_back"] 으로 적는다.
  "ExcludedSlotNames": [],

  // 건드리지 않을 헬멧 아이템 id. 예: ["5c0919b50db834001b7ce3b9"]
  "ExcludedHelmetIds": []
}
