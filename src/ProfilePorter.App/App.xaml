<Application x:Class="ProfilePorter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- 게임 옆에 띄워 두는 창이다. 어두운 바탕이 눈에 덜 튄다(AirdropCaller 와 같은 색). -->
    <SolidColorBrush x:Key="Bg" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Panel" Color="#252526" />
    <SolidColorBrush x:Key="Fg" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Dim" Color="#B8B8B8" />
    <SolidColorBrush x:Key="Line" Color="#3A3A3C" />
    <SolidColorBrush x:Key="Accent" Color="#C8A050" />
    <SolidColorBrush x:Key="Warn" Color="#D07070" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
      목록 **항목**은 컨트롤의 Foreground 를 물려받지 않는다. 어두운 바탕에 기본 회색
      글씨가 얹히면 안 읽힌다 — 항목에 직접 색을 준다(AirdropCaller 가 같은 자리에서
      값을 치렀다).
    -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,3" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4A4A52" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#3A3A42" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!--
      단추도 템플릿을 직접 준다. WPF 기본 템플릿은 **꺼진 단추**를 흰 바탕·회색 글씨로
      그려서, 어두운 창에서 글자가 사라진다. 꺼진 것도 무슨 단추인지는 읽혀야 한다.
    -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="#3A3A3C" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#4A4A52" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#55555E" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Back" Property="Background" Value="#2A2A2C" />
                <Setter TargetName="Body" Property="TextElement.Foreground" Value="{StaticResource Dim}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
