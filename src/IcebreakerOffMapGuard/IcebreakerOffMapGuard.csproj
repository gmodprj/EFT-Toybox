<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>IcebreakerOffMapGuard</AssemblyName>
    <RootNamespace>IcebreakerOffMapGuard</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <DebugType>none</DebugType>
    <!-- 설치 경로. 다른 곳에 SPT 가 있으면 -p:SptDir=... 로 덮어쓴다 -->
    <SptDir Condition="'$(SptDir)' == ''">E:\Spt</SptDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    아이스브레이커 모드의 어셈블리는 **참조하지 않는다.** 그 DLL 이 11 MB 이고,
    참조해 버리면 그 모드가 없는 설치본에서 우리 플러그인이 타입을 못 찾아 터진다.
    대상은 런타임에 AccessTools 로 이름으로 찾고, 없으면 아무것도 걸지 않는다.
  -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SptDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
