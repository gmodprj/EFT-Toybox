<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DynamicMapsFactionMarkers</AssemblyName>
    <RootNamespace>DynamicMapsFactionMarkers</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <DebugType>none</DebugType>
    <!-- 설치 경로. 다른 곳에 SPT가 있으면 -p:SptDir=... 로 덮어쓴다 -->
    <SptDir Condition="'$(SptDir)' == ''">E:\Spt</SptDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SptDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SptDir)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 마커를 그리는 쪽. 이 모드가 없으면 BepInEx 가 우리 플러그인을 건너뛴다(하드 의존) -->
    <Reference Include="DynamicMaps">
      <HintPath>$(SptDir)\BepInEx\plugins\mpstark-dynamicmaps\DynamicMaps.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
