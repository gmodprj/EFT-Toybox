@inject ConfigStore Store
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<MudText Typo="Typo.h6" GutterBottom="true">Dynamic Maps</MudText>
<MudText Typo="Typo.body2" Class="mb-4">레이드 중 지도에 어떤 표식을 띄울지 정한다.</MudText>

@if (_config is null)
{
    <MudAlert Severity="Severity.Warning">
        설정 파일을 찾지 못했다. <code>user/mods/mpstark-dynamicmaps</code> 를 확인하라.
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudSwitch T="bool" @bind-Value="_config.AllowShowFriendlyPlayerMarkersInRaid" Color="Color.Primary"
                   Label="아군 플레이어 표식" />
        <MudSwitch T="bool" @bind-Value="_config.AllowShowEnemyPlayerMarkersInRaid" Color="Color.Primary"
                   Label="적 플레이어 표식" />
        <MudSwitch T="bool" @bind-Value="_config.AllowShowBossMarkersInRaid" Color="Color.Primary"
                   Label="보스 표식" />
        <MudSwitch T="bool" @bind-Value="_config.AllowShowScavMarkersInRaid" Color="Color.Primary"
                   Label="스캐브 표식" />
    </MudPaper>

    <SaveBar OnSave="Save" OnReload="Reload" Path="@Store.PathOf(ConfigStore.Targets.DynamicMaps)" />
}

@code {
    private DynamicMapsConfig? _config;
    private readonly ConfigStamp _stamp = new();

    protected override void OnInitialized() => Reload();

    private void Reload() =>
        _config = Store.Load<DynamicMapsConfig>(ConfigStore.Targets.DynamicMaps, _stamp);

    private async Task Save()
    {
        if (_config is null) return;
        await SaveResult.ReportAsync(
            Store, Snackbar, Dialog, ConfigStore.Targets.DynamicMaps, _config, _stamp, Reload);
    }
}
