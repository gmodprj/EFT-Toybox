@inject ConfigStore Store
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<MudText Typo="Typo.h6" GutterBottom="true">Slot Category Relax</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    분류를 골라 칸을 넓힌다. 어떤 칸이 켠 분류의 부품을 하나라도 받고 있으면,
    그 칸에 같은 분류의 부품을 모두 넣는다. 켜지 않은 분류는 그 총에 맞는 것만 들어간다.
</MudText>

@if (_config is null)
{
    <MudAlert Severity="Severity.Warning">
        설정 파일을 찾지 못했다. <code>user/mods/SlotCategoryRelax</code> 를 확인하라.
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudSwitch T="bool" @bind-Value="_config.ModEnabled" Color="Color.Primary"
                   Label="모드 사용 — 끄면 데이터베이스를 건드리지 않는다" />
        <MudSwitch T="bool" @bind-Value="_config.IncludeAttachmentSlots" Color="Color.Primary"
                   Label="부품의 하위 칸까지 — 마운트 위에 조준경을 올리는 조합" />
        <MudSwitch T="bool" @bind-Value="_config.Debug" Color="Color.Primary"
                   Label="자세한 기록 — 칸마다 몇 개가 늘었는지" />
    </MudPaper>

    @if (_discovered.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            분류 목록이 아직 없다. 서버를 한 번 켜면 그 모드가 설치본을 훑어 목록을 내놓는다.
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="mb-2">
            이 설치본에서 찾은 분류 @_discovered.Count 종. 괄호 안은 그 분류의 아이템 수다.
        </MudText>

        @foreach (var group in Grouped)
        {
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">@group.Key</MudText>
                @foreach (var category in group)
                {
                    <MudSwitch T="bool" Color="@ColorOf(group.Key)"
                               Value="IsOn(category.Name)"
                               ValueChanged="@(v => SetOn(category.Name, v))"
                               Label="@($"{category.Name} ({category.Items})")" />
                }
            </MudPaper>
        }
    }

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">약실</MudText>
        <MudSwitch T="bool" @bind-Value="_config.RelaxChambers" Color="Color.Warning"
                   Label="모든 총기의 약실에 모든 탄종 — 약실이 받던 분류의 탄을 전부 넣는다" />
        <MudText Typo="Typo.caption">
            약실은 부품 칸이 아니라 Chambers 라 위의 분류 스위치가 닿지 않는다. 탄창은 건드리지 않으므로
            다른 구경의 탄은 약실에 한 발씩 물리는 것까지다.
        </MudText>

        <MudTextField T="string" @bind-Value="_excludedChamberWeapons" Lines="3" Variant="Variant.Outlined"
                      Class="mt-4" Label="약실을 넓히지 않을 총기 id"
                      HelperText="한 줄에 하나씩. 예: 5e81ebcd8e146c7080625e15 (FN40GL 유탄발사기), 620109578d82e67e7911abf2 (SP-81 신호권총)" />
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">건드리지 않을 칸</MudText>
        <MudTextField T="string" @bind-Value="_excludedSlots" Lines="3" Variant="Variant.Outlined"
                      Label="칸 이름"
                      HelperText="한 줄에 하나씩. 예: mod_magazine — 분류가 켜져 있어도 그 칸은 그대로 둔다." />
    </MudPaper>

    <SaveBar OnSave="Save" OnReload="Reload" Path="@Store.PathOf(ConfigStore.Targets.SlotCategoryRelax)" />
}

@code {
    private SlotCategoryRelaxConfig? _config;
    private readonly ConfigStamp _stamp = new();
    private List<DiscoveredCategory> _discovered = [];
    private string _excludedSlots = string.Empty;
    private string _excludedChamberWeapons = string.Empty;

    /// <summary>
    /// 분류를 계열로 묶어 보여준다. 여기 없는 이름은 "그 밖" 으로 간다 —
    /// 다른 모드가 분류를 더해도 화면에서 빠지지 않게.
    /// </summary>
    private static readonly Dictionary<string, string> Family = new(StringComparer.OrdinalIgnoreCase)
    {
        ["AssaultScope"] = "조준", ["OpticScope"] = "조준", ["SpecialScope"] = "조준",
        ["Collimator"] = "조준", ["CompactCollimator"] = "조준", ["IronSight"] = "조준",
        ["NightVision"] = "조준", ["ThermalVision"] = "조준",

        ["Mount"] = "거치", ["TacticalCombo"] = "거치", ["AuxiliaryMod"] = "거치",
        ["Bipod"] = "거치", ["Foregrip"] = "거치", ["Flashlight"] = "거치",

        ["Silencer"] = "총구", ["FlashHider"] = "총구", ["MuzzleCombo"] = "총구",

        ["Handguard"] = "구조", ["Stock"] = "구조", ["PistolGrip"] = "구조",
        ["Receiver"] = "구조", ["Barrel"] = "구조", ["Gasblock"] = "구조",
        ["Charge"] = "구조", ["Launcher"] = "구조",

        ["Magazine"] = "탄창", ["CylinderMagazine"] = "탄창", ["SpringDrivenCylinder"] = "탄창",
    };

    private static readonly string[] FamilyOrder = ["조준", "거치", "총구", "구조", "탄창", "그 밖"];

    private IEnumerable<IGrouping<string, DiscoveredCategory>> Grouped =>
        _discovered
            .GroupBy(c => Family.GetValueOrDefault(c.Name, "그 밖"))
            .OrderBy(g => Array.IndexOf(FamilyOrder, g.Key));

    /// <summary>구조·탄창은 켜면 체감이 크게 달라지므로 경고색으로 둔다.</summary>
    private static Color ColorOf(string family) =>
        family is "구조" or "탄창" ? Color.Warning : Color.Primary;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _config = Store.Load<SlotCategoryRelaxConfig>(ConfigStore.Targets.SlotCategoryRelax, _stamp);
        _discovered = Store.Load<List<DiscoveredCategory>>(ConfigStore.Targets.SlotCategoryRelaxDiscovered) ?? [];
        _excludedSlots = TextLines.Join(_config?.ExcludedSlotNames);
        _excludedChamberWeapons = TextLines.Join(_config?.ExcludedChamberWeaponIds);
    }

    private bool IsOn(string name) =>
        _config is not null && _config.Categories.TryGetValue(name, out var on) && on;

    private void SetOn(string name, bool value)
    {
        if (_config is null) return;
        _config.Categories[name] = value;
    }

    private async Task Save()
    {
        if (_config is null) return;

        _config.ExcludedSlotNames = TextLines.Split(_excludedSlots);
        _config.ExcludedChamberWeaponIds = TextLines.Split(_excludedChamberWeapons);
        await SaveResult.ReportAsync(
            Store, Snackbar, Dialog, ConfigStore.Targets.SlotCategoryRelax, _config, _stamp, Reload);
    }
}
