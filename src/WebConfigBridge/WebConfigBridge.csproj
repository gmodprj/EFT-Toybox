<!-- Razor SDK: 모드 페이지(Blazor 컴포넌트)를 DLL 안에 함께 담는다. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- SPT 4.1.6 서버는 net10.0 이다(SPT.Server.runtimeconfig.json 의 tfm). -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WebConfigBridge</AssemblyName>
    <RootNamespace>WebConfigBridge</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <!-- 서버가 이미 들고 있는 어셈블리를 다시 복사하지 않는다 -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <!-- 정적 자원은 쓰지 않는다. 서버 폴더에 들어가는 것은 DLL 하나뿐이어야 한다. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- 설치 경로. 다른 곳에 SPT가 있으면 -p:SptDir=... 로 덮어쓴다 -->
    <SptDir Condition="'$(SptDir)' == ''">E:\Spt</SptDir>
    <ServerDir>$(SptDir)\SPT_Runtime</ServerDir>
  </PropertyGroup>

  <!-- 서버가 ASP.NET Core 위에서 돈다. 프레임워크는 참조만 하고 싣지 않는다. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(ServerDir)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Web">
      <HintPath>$(ServerDir)\SPTarkov.Server.Web.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(ServerDir)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(ServerDir)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(ServerDir)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MudBlazor">
      <HintPath>$(ServerDir)\MudBlazor.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
