<Window x:Class="AirdropCaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보급 호출기" Height="640" Width="1040"
        Background="{StaticResource Bg}" UseLayoutRounding="True">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <!-- ① 프리셋 목록 -->
    <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
      <Label DockPanel.Dock="Top" Content="프리셋" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="NewPresetButton" Content="새로" Click="OnNewPreset" />
        <Button x:Name="DeletePresetButton" Content="삭제" Click="OnDeletePreset" />
      </StackPanel>
      <ListBox x:Name="PresetList" DisplayMemberPath="Name" SelectionChanged="OnPresetSelected" />
    </DockPanel>

    <!-- ② 고른 프리셋의 품목 -->
    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,0">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Content="이름" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBox Grid.Column="1" x:Name="PresetNameBox" />
        <Label Grid.Column="2" Content="상자" VerticalAlignment="Center" Margin="10,0,6,0" />
        <ComboBox Grid.Column="3" x:Name="IconBox" Width="110">
          <ComboBoxItem Content="Common" />
          <ComboBoxItem Content="Supply" />
          <ComboBoxItem Content="Medical" />
          <ComboBoxItem Content="Weapon" />
        </ComboBox>
        <Button Grid.Column="4" x:Name="SaveButton" Content="저장" Click="OnSavePreset" Margin="10,0,0,0" />
      </Grid>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="RemoveItemButton" Content="품목 빼기" Click="OnRemoveItem" />
        <TextBlock x:Name="FitHint" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
      </StackPanel>

      <DataGrid x:Name="ItemGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                HeadersVisibility="Column" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="품목" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
          <DataGridTextColumn Header="개수" Binding="{Binding Count}" Width="70" />
          <DataGridTextColumn Header="묶음" Binding="{Binding StackSize}" Width="80" />
          <DataGridTextColumn Header="tpl" Binding="{Binding Tpl}" IsReadOnly="True" Width="190" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <!-- ③ 아이템 찾기 — 분류로 훑거나 이름으로 찾는다 -->
    <DockPanel Grid.Row="0" Grid.Column="2">
      <Label DockPanel.Dock="Top" Content="아이템 찾기" />
      <ComboBox DockPanel.Dock="Top" x:Name="CategoryBox" DisplayMemberPath="Display"
                SelectionChanged="OnCategoryChanged" Margin="0,0,0,4" />
      <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="SearchBox" KeyDown="OnSearchKeyDown" />
        <Button Grid.Column="1" x:Name="SearchButton" Content="찾기" Click="OnSearch" Margin="6,0,0,0" />
      </Grid>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="AddItemButton" Content="품목에 넣기" Click="OnAddItem" />
        <TextBlock x:Name="SearchHint" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
      </StackPanel>
      <ListBox x:Name="SearchList" DisplayMemberPath="Display" MouseDoubleClick="OnAddItem">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Accent}"
                           FontWeight="SemiBold" Margin="0,8,0,2" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
      </ListBox>
    </DockPanel>

    <!-- 상태줄 + 드롭 -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="10"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="StateLine" Text="서버에 붙는 중…" FontSize="14" />
          <!-- 상태(2초마다 갱신)와 내가 한 일의 결과를 따로 둔다. 섞어 두었더니
               "저장했다" 같은 문구가 2초 만에 지워졌다. -->
          <TextBlock x:Name="DetailLine" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0" />
          <TextBlock x:Name="MessageLine" Foreground="{StaticResource Accent}" FontSize="12"
                     Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="CancelButton" Content="예약 취소" Click="OnCancel" IsEnabled="False" />
        <Button Grid.Column="2" x:Name="DropButton" Content="떨어뜨리기" Click="OnDrop" IsEnabled="False"
                FontSize="15" FontWeight="SemiBold" Padding="20,8" Margin="0"
                Background="{StaticResource Accent}" Foreground="#1E1E1E" />
      </Grid>
    </Border>
  </Grid>
</Window>
