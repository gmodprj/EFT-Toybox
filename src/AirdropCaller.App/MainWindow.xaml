<Window x:Class="AirdropCaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보급 호출기" Height="660" Width="1100" MinHeight="420" MinWidth="780"
        Background="{StaticResource Bg}" UseLayoutRounding="True">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- 세 칸 사이에 손잡이를 둔다. 넓이는 쓰는 사람이 정한다. -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" MinWidth="120" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" MinWidth="240" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="360" MinWidth="220" />
    </Grid.ColumnDefinitions>

    <!-- ① 프리셋 -->
    <DockPanel Grid.Row="0" Grid.Column="0">
      <Label DockPanel.Dock="Top" Content="프리셋" />
      <!-- 단추가 넷이라 210px 칸에 가로로 늘어놓으면 마지막이 잘려 보이지 않는다(2026-11-07 실측).
           WrapPanel 로 두어 칸이 좁으면 다음 줄로 내려간다. -->
      <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="NewPresetButton" Content="새로" Click="OnNewPreset" Padding="8,5" />
        <Button x:Name="CopyPresetButton" Content="복사" Click="OnCopyPreset" Padding="8,5" />
        <Button x:Name="DeletePresetButton" Content="삭제" Click="OnDeletePreset" Padding="8,5" />
        <!-- 지금 입고 있는 것을 그대로 뽑아 편집기에 올린다(설계 §18). 저장은 사람이 누른다. -->
        <Button x:Name="ExtractWornButton" Content="입은 것" Click="OnExtractWorn" Padding="8,5"
                ToolTip="지금 로그인한 프로필이 입고 있는 장비를 프리셋으로 뽑는다. 보안 컨테이너는 뺀다." />
      </WrapPanel>
      <ListBox x:Name="PresetList" DisplayMemberPath="Name" SelectionChanged="OnPresetSelected" />
    </DockPanel>

    <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" />

    <!-- ② 고른 프리셋의 품목 -->
    <DockPanel Grid.Row="0" Grid.Column="2">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Content="이름" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBox Grid.Column="1" x:Name="PresetNameBox" />
        <Label Grid.Column="2" Content="상자" VerticalAlignment="Center" Margin="10,0,6,0" />
        <ComboBox Grid.Column="3" x:Name="IconBox" Width="110">
          <ComboBoxItem Content="Common" />
          <ComboBoxItem Content="Supply" />
          <ComboBoxItem Content="Medical" />
          <ComboBoxItem Content="Weapon" />
        </ComboBox>
        <!-- 겉모습은 위 상자 종류가 그대로 정한다. 안 격자만 커진다. -->
        <CheckBox Grid.Column="4" x:Name="BigCrateBox" Content="큰 상자"
                  VerticalAlignment="Center" Margin="10,0,0,0"
                  ToolTip="보급 상자를 30×30=900칸으로 키운다. 겉모습과 제목은 그대로다." />
        <Button Grid.Column="5" x:Name="SaveButton" Content="저장" Click="OnSavePreset" Margin="10,0,0,0" />
      </Grid>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="RemoveItemButton" Content="품목 빼기" Click="OnRemoveItem" />
        <TextBlock x:Name="FitHint" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
      </StackPanel>

      <DataGrid x:Name="ItemGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                HeadersVisibility="Column" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <!-- 아이템 그림. 못 구하면 분류 아이콘이 들어온다(코드에서 채운다). -->
                <Image Source="{Binding ItemIcon}" Width="22" Height="22" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="품목" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="150" />
          <DataGridTextColumn Header="개수" Binding="{Binding Count}" Width="60" />
          <DataGridTextColumn Header="묶음" Binding="{Binding StackSize}" Width="70" />
          <!-- 채우기. 자동이면 방어구에 삽입물·방어판이 붙는다. 가득은 야시경까지.
               **`DataContext.` 를 붙이지 않는다.** 이 창은 자기 DataContext 를 두지
               않아서, 그렇게 묶으면 목록이 영영 비어 있다(2026-10-30 에 그랬다). -->
          <DataGridTemplateColumn Header="채우기" Width="74">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding FillChoices,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding FillLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          BorderThickness="0" Background="Transparent" Padding="4,4" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- 담을 곳. 비우면 보급 상자에 직접 들어간다. -->
          <DataGridTemplateColumn Header="담을 곳" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding ContainerChoices,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Choice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          BorderThickness="0" Background="Transparent" Padding="4,4">
                  <!-- DisplayMemberPath 를 쓰면 **접힌 칸**에 글자가 안 나온다.
                       우리 ComboBox 템플릿이 SelectionBoxItemTemplate 을 못 받아서다.
                       ItemTemplate 을 직접 주면 그 길로 흘러간다. -->
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- 칸 고르기. 칸이 있는 품목(방어구 등)에서만 쓸모가 있다. -->
          <DataGridTemplateColumn Header="칸" Width="84">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <!-- 몇 칸을 직접 골랐는지 버튼 자신이 말한다. 칸을 하나 더 쓰면
                     가운데 칸이 좁아 품목 이름이 먼저 잘린다. -->
                <Button Content="{Binding SlotHint}" Click="OnEditSlots" Padding="4,1" Margin="0"
                        HorizontalAlignment="Stretch"
                        ToolTip="이 품목의 칸마다 무엇을 달지 직접 고른다." />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- tpl 은 평소엔 볼 일이 없다. 좁게 두고 필요하면 끌어서 넓힌다. -->
          <DataGridTextColumn Header="tpl" Binding="{Binding Tpl}" IsReadOnly="True" Width="90" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <GridSplitter Grid.Row="0" Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" />

    <!-- ③ 아이템 찾기 — 분류로 훑거나 이름으로 찾는다 -->
    <DockPanel Grid.Row="0" Grid.Column="4">
      <Grid DockPanel.Dock="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Content="아이템 찾기" />
        <Button Grid.Column="1" x:Name="ReloadButton" Content="새로고침" Click="OnReload"
                Margin="0" Padding="8,2" />
      </Grid>
      <ComboBox DockPanel.Dock="Top" x:Name="CategoryBox"
                SelectionChanged="OnCategoryChanged" Margin="0,4,0,4" MaxDropDownHeight="420">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Image Source="{Binding Icon, Converter={StaticResource FileToIcon}}"
                     Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Display}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <!-- 입력과 동시에 거른다. 찾기 버튼을 눌러야만 되는 것은 안 되는 것과 같다. -->
      <TextBox DockPanel.Dock="Top" x:Name="SearchBox" TextChanged="OnSearchTextChanged" Margin="0,0,0,6" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="AddItemButton" Content="품목에 넣기" Click="OnAddItem" />
        <Button x:Name="FavoriteButton" Content="즐겨찾기 ☆" Click="OnToggleFavorite" />
        <TextBlock x:Name="SearchHint" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
      </StackPanel>
      <ListBox x:Name="SearchList" MouseDoubleClick="OnAddItem"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <!--
              가로로 늘어놓으면(StackPanel) 줄이 칸보다 길어져 **오른쪽이 잘려 나간다** —
              크기 표시가 잘려 "1×1 ·9" 로 보였다. 표로 짜고 이름만 남는 자리를
              차지하게 해서, 길면 이름이 접히게 한다.
            -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Grid.Column="0" Source="{Binding ItemIcon}" Width="22" Height="22"
                     Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Star}" Width="16"
                         Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Name}" TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" />
              <TextBlock Grid.Column="3" Text="{Binding Size}" Foreground="{StaticResource Dim}"
                         FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Accent}"
                           FontWeight="SemiBold" Margin="0,8,0,2" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
      </ListBox>
    </DockPanel>

    <!-- 상태줄 + 드롭 -->
    <Border Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0" Padding="10"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="StateLine" Text="서버에 붙는 중…" FontSize="14" />
          <!-- 상태(2초마다 갱신)와 내가 한 일의 결과를 따로 둔다. 섞어 두었더니
               "저장했다" 같은 문구가 2초 만에 지워졌다. -->
          <TextBlock x:Name="DetailLine" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0" />
          <TextBlock x:Name="MessageLine" Foreground="{StaticResource Accent}" FontSize="12"
                     Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox Grid.Column="1" x:Name="TopmostBox" Content="항상 위" VerticalAlignment="Center"
                  Margin="0,0,14,0" Foreground="{StaticResource Dim}" Checked="OnTopmostChanged"
                  Unchecked="OnTopmostChanged" />
        <Button Grid.Column="2" x:Name="CancelButton" Content="예약 취소" Click="OnCancel" IsEnabled="False" />
        <Button Grid.Column="3" x:Name="DropButton" Content="떨어뜨리기" Click="OnDrop" IsEnabled="False"
                FontSize="15" FontWeight="SemiBold" Padding="20,8" Margin="0"
                Background="{StaticResource Accent}" Foreground="#1E1E1E" />
      </Grid>
    </Border>
  </Grid>
</Window>
