<Window x:Class="AirdropCaller.App.SlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="칸 고르기" Height="560" Width="820" MinHeight="300" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" UseLayoutRounding="True">
  <DockPanel Margin="10">

    <TextBlock DockPanel.Dock="Top" x:Name="HeadLine" FontSize="14" Margin="0,0,0,2" />
    <TextBlock DockPanel.Dock="Top" x:Name="SubLine" Foreground="{StaticResource Dim}"
               TextWrapping="Wrap" Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="ResetButton" Content="전부 자동으로" Click="OnReset" Margin="0,0,8,0" />
      <Button x:Name="CloseButton" Content="닫기" Click="OnClose" IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <!-- 줄마다 따로 재면 드롭다운 왼쪽 끝이 들쭉날쭉해진다. 이름 칸을 줄끼리
           나눠 쓰게 해서 한 줄로 세운다. -->
      <ItemsControl x:Name="SlotList" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <!-- 칸 이름은 길어야 `Right_side_plate` 라 Auto 로 족하다.
                     **남는 폭은 드롭다운이 가져간다** — 창을 넓혔는데 부속 이름이
                     그대로 잘려 보이면 넓힌 보람이 없다(2026-10-30 지적받았다). -->
                <ColumnDefinition Width="Auto" SharedSizeGroup="SlotName" />
                <ColumnDefinition Width="*" MinWidth="240" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="{Binding KindLabel}"
                         Foreground="{Binding KindBrush}" VerticalAlignment="Center" />

              <!-- 겹친 칸은 들여쓴다. 헬멧은 마운트 안에 또 칸이 있다.
                   칸을 따로 두지 않고 여백으로 민다 — 따로 두면 그 폭만큼
                   드롭다운이 줄마다 다른 자리에서 시작한다. -->
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                         Margin="{Binding Indent}" Padding="0,0,12,0"
                         ToolTip="{Binding Path}" />

              <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}">
                <!-- DisplayMemberPath 를 쓰면 접힌 칸에 글자가 안 나온다(우리 ComboBox
                     템플릿이 SelectionBoxItemTemplate 을 못 받는다). 직접 준다. -->
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <!-- 같이 못 다는 것은 고를 수 없게 막는다. -->
                    <Setter Property="IsEnabled" Value="{Binding Selectable}" />
                    <Setter Property="ToolTip" Value="{Binding Hint}" />
                  </Style>
                </ComboBox.ItemContainerStyle>
              </ComboBox>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
