<Window x:Class="AirdropCaller.App.SlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="칸 고르기" Height="560" Width="640" MinHeight="300" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" UseLayoutRounding="True">
  <DockPanel Margin="10">

    <TextBlock DockPanel.Dock="Top" x:Name="HeadLine" FontSize="14" Margin="0,0,0,2" />
    <TextBlock DockPanel.Dock="Top" x:Name="SubLine" Foreground="{StaticResource Dim}"
               TextWrapping="Wrap" Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="ResetButton" Content="전부 자동으로" Click="OnReset" Margin="0,0,8,0" />
      <Button x:Name="CloseButton" Content="닫기" Click="OnClose" IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="SlotList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <!-- 겹친 칸은 들여쓴다. 헬멧은 마운트 안에 또 칸이 있다. -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" MinWidth="110" />
                <ColumnDefinition Width="260" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Width="{Binding Indent}" />

              <TextBlock Grid.Column="1" Text="{Binding KindLabel}"
                         Foreground="{Binding KindBrush}" VerticalAlignment="Center" />

              <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />

              <ComboBox Grid.Column="3" ItemsSource="{Binding Choices}"
                        DisplayMemberPath="Label"
                        SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <!-- 같이 못 다는 것은 고를 수 없게 막는다. -->
                    <Setter Property="IsEnabled" Value="{Binding Selectable}" />
                    <Setter Property="ToolTip" Value="{Binding Hint}" />
                  </Style>
                </ComboBox.ItemContainerStyle>
              </ComboBox>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
