<Application x:Class="AirdropCaller.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:local="clr-namespace:AirdropCaller.App"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <local:HexToBrushConverter x:Key="HexToBrush" />
    <local:FileToIconConverter x:Key="FileToIcon" />
    <!-- 게임 옆에 띄워 두는 창이다. 어두운 바탕이 눈에 덜 튄다. -->
    <SolidColorBrush x:Key="Bg" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Panel" Color="#252526" />
    <!-- 어두운 바탕에 얹는 글자다. 회색이면 안 읽힌다 — 거의 흰색으로 둔다. -->
    <SolidColorBrush x:Key="Fg" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Dim" Color="#B8B8B8" />
    <SolidColorBrush x:Key="Line" Color="#3A3A3C" />
    <SolidColorBrush x:Key="Accent" Color="#C8A050" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <!--
      콤보는 **템플릿을 직접 준다.**

      WPF 기본 템플릿은 닫힌 상태의 바탕을 자기 리소스(흰색)로 그리고 `Background` 를
      무시한다. 그래서 글자색만 밝게 줬더니 **흰 바탕에 흰 글자**가 됐다. 항목
      (`ComboBoxItem`)만 칠해서는 닫힌 쪽을 못 고친다.

      `Background` 는 TemplateBinding 으로 받는다 — 품목 표의 "담을 곳" 칸은 투명하게
      두고 싶기 때문이다.
    -->
    <Style TargetType="ComboBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <!-- 바탕·테두리는 콤보에서 받아 온다. 안 그러면 토글 자신의 기본값(없음)이 쓰인다. -->
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                      <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"
                            Fill="{StaticResource Dim}" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border Background="#2D2D30" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer>
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>

            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Toggle" Property="Background" Value="#3A3A42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
      목록·콤보의 **항목**은 컨트롤의 Foreground 를 물려받지 않는다. 그래서 어두운 바탕에
      기본 회색 글씨가 얹혀 읽기 어려웠다. 항목에 직접 색을 준다.
    -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,3" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4A4A52" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#3A3A42" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Padding" Value="6,4" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#4A4A52" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type prim:DataGridColumnHeader}">
      <Setter Property="Background" Value="#3A3A3C" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderThickness" Value="0" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4A4A52" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="RowBackground" Value="#2D2D30" />
      <Setter Property="AlternatingRowBackground" Value="#303033" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <!--
      단추도 템플릿을 직접 준다. 기본 템플릿은 **꺼진 단추**를 자기 리소스(흰 바탕,
      회색 글씨)로 그려서, 어두운 창에서 "떨어뜨리기" 가 흰 바탕에 흰 글씨가 됐다.
      꺼진 것도 **무슨 단추인지는 읽혀야** 한다.
    -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="#3A3A3C" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#4A4A52" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Back" Property="Background" Value="#55555E" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Back" Property="Background" Value="#2A2A2C" />
                <!-- 글자색도 여기서 덮는다. "떨어뜨리기" 는 켜졌을 때 어두운 글자라
                     바탕만 어둡게 하면 글자가 사라진다. -->
                <Setter TargetName="Body" Property="TextElement.Foreground" Value="{StaticResource Dim}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
