<Application x:Class="AirdropCaller.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- 게임 옆에 띄워 두는 창이다. 어두운 바탕이 눈에 덜 튄다. -->
    <SolidColorBrush x:Key="Bg" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Panel" Color="#252526" />
    <SolidColorBrush x:Key="Fg" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Dim" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Line" Color="#3A3A3C" />
    <SolidColorBrush x:Key="Accent" Color="#C8A050" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="RowBackground" Value="#2D2D30" />
      <Setter Property="AlternatingRowBackground" Value="#303033" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#3A3A3C" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </Application.Resources>
</Application>
