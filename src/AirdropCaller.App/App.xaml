<Application x:Class="AirdropCaller.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:local="clr-namespace:AirdropCaller.App"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <local:HexToBrushConverter x:Key="HexToBrush" />
    <local:FileToIconConverter x:Key="FileToIcon" />
    <!-- 게임 옆에 띄워 두는 창이다. 어두운 바탕이 눈에 덜 튄다. -->
    <SolidColorBrush x:Key="Bg" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Panel" Color="#252526" />
    <!-- 어두운 바탕에 얹는 글자다. 회색이면 안 읽힌다 — 거의 흰색으로 둔다. -->
    <SolidColorBrush x:Key="Fg" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Dim" Color="#B8B8B8" />
    <SolidColorBrush x:Key="Line" Color="#3A3A3C" />
    <SolidColorBrush x:Key="Accent" Color="#C8A050" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <!--
      닫힌 콤보의 글자는 **항목이 아니라 콤보 자신의 Foreground** 로 그려진다.
      ComboBoxItem 만 칠해 두었더니 닫혀 있을 때는 여전히 회색이었다.
    -->
    <Style TargetType="ComboBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
      목록·콤보의 **항목**은 컨트롤의 Foreground 를 물려받지 않는다. 그래서 어두운 바탕에
      기본 회색 글씨가 얹혀 읽기 어려웠다. 항목에 직접 색을 준다.
    -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,3" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4A4A52" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#3A3A42" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Padding" Value="6,4" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#4A4A52" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type prim:DataGridColumnHeader}">
      <Setter Property="Background" Value="#3A3A3C" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderThickness" Value="0" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4A4A52" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#2D2D30" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="RowBackground" Value="#2D2D30" />
      <Setter Property="AlternatingRowBackground" Value="#303033" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#3A3A3C" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </Application.Resources>
</Application>
