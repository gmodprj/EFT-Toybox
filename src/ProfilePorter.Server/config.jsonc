{
  // false 면 라우트가 전부 거절한다. 설치해 둔 채 끌 수 있다.
  "ModEnabled": true,

  // 요청마다 무엇을 했는지 서버 로그에 적는다.
  "Debug": true,

  // 들여올 수 없는 아이템 종류(tpl).
  //
  // 비워 두어도 된다 — 퀘스트 물품은 questRaidItems·questStashItems 라는 **별도 루트**에 있어
  // 스태시 바닥을 고르는 길로는 애초에 들어오지 않는다(설계 §9.1 실측).
  // 여기는 "그래도 막고 싶은 것" 을 사람이 적는 자리다.
  "BlockedTemplateIds": [],

  // 들여오기 전에 받는 쪽 프로필을 백업한다. **끄는 것을 권하지 않는다** —
  // 들여오기는 되돌릴 수 없는 쓰기다(설계 §4.6).
  "BackupBeforeImport": true,

  // 보낸 우편을 며칠 보관할지. **짧으면 못 받고 사라진다.** 1~365.
  "MailStorageDays": 7
}
