<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SPT 4.1.6 서버는 net10.0 이다. AirdropCaller.Server 와 같은 자리에 맞춘다. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProfilePorter.Server</AssemblyName>
    <RootNamespace>ProfilePorter.Server</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <SptDir Condition="'$(SptDir)' == ''">E:\Spt</SptDir>
    <ServerDir>$(SptDir)\SPT_Runtime</ServerDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(ServerDir)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(ServerDir)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(ServerDir)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(ServerDir)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="config.jsonc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
