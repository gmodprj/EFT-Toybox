{
  // false 면 모든 요청을 바닐라에 그대로 넘긴다. 설치해 둔 채 끌 수 있다.
  "ModEnabled": true,

  // 요청마다 어느 상자였고 무엇을 담았는지 서버 로그에 적는다.
  "Debug": true,

  // 상자 id → 담을 것.
  //
  // 이 id 는 게임이 InitAirdrop(lootTemplateId, ...) 에 넘긴 값이 그대로 돌아온 것이다.
  // 여기에 없는 id 는 건드리지 않고 바닐라가 만든 답을 그대로 흘려보낸다.
  //
  // 아래 id 는 AirdropProbe(측정기)의 "전리품 id" 기본값과 같다.
  // 레이드에서 Ctrl+Alt+D 를 누르면 이 상자가 떨어진다.
  "Drops": {
    "aabbccdd0000000000000001": {
      // Common / Supply / Medical / Weapon
      "Icon": "Medical",

      // 무작위로는 절대 이렇게 안 나오는 조합을 넣어 둔다 —
      // 이것이 나오면 우리가 넘긴 id 가 서버의 답을 바꿨다는 뜻이다.
      "Items": [
        { "Tpl": "5449016a4bdc2d6f028b456f", "Count": 2, "StackSize": 250000 }, // 루블
        { "Tpl": "5696686a4bdc2da3298b456a", "Count": 2, "StackSize": 5000 },   // 달러
        { "Tpl": "569668774bdc2da2298b4568", "Count": 2, "StackSize": 5000 },   // 유로
        { "Tpl": "5d02778e86f774203e7dedbe", "Count": 2 },                      // CMS 휴대용 수술 키트
        { "Tpl": "544fb3f34bdc2d03748b456a", "Count": 4 },                      // 모르핀 주사기
        { "Tpl": "5751a89d24597722aa0e8db0", "Count": 4 },                      // 골든스타 연고
        { "Tpl": "590c5d4b86f774784e1b9c45", "Count": 4 },                      // Iskra 전투식량
        { "Tpl": "5e8f3423fd7471236e6e3b64", "Count": 4 }                       // 프리미엄 크바스
      ]
    },

    // 넘침 확인용. 상자는 10×12=120칸인데 4×4 방탄복을 20개(320칸) 넣으라고 한다.
    // 들어갈 만큼만 담기고 나머지는 "자리 없음" 으로 돌아와야 한다. 조용히 버리면 안 된다.
    "aabbccdd0000000000000002": {
      "Icon": "Weapon",
      "Items": [
        { "Tpl": "5b44cd8b86f774503d30cba2", "Count": 20 } // IOTV Gen4 (완전형) 4×4
      ]
    },

    // 묶음 깎기 확인용. 적어 낸 묶음이 아이템 최대치를 넘으면 깎고 말해 줘야 한다.
    // 그대로 내보내면 레이드 끝에 서버가 그 아이템을 어떻게 받아 줄지 알 수 없다.
    //
    // 최대치는 **지금 돌고 있는 서버의 DB** 가 정한다. 어느 설정 파일도 진실이 아니다 —
    // 스택을 바꾸는 서버 모드가 여럿 지나간 뒤의 값이라야 맞다. 그래서 두 줄이 하는
    // 일이 다르다.
    "aabbccdd0000000000000003": {
      "Icon": "Common",
      "Items": [
        // 안 깎이는 쪽. items.json 에는 최대 1000000 으로 적혀 있지만, 이 설치본의
        // 서버는 50000000 을 들고 있다(스택 모드가 올려 놨다). 그 아래라 그대로 간다.
        { "Tpl": "5449016a4bdc2d6f028b456f", "Count": 1, "StackSize": 9999999 },

        // 깎이는 쪽. 모르핀은 애초에 안 묶인다(최대 1) → "고친 것" 으로 돌아온다.
        { "Tpl": "544fb3f34bdc2d03748b456a", "Count": 1, "StackSize": 50 }
      ]
    },

    // 방어구 채우기 확인용.
    //
    // Fill 을 안 적으면 Auto — 방어구면 삽입물과 방어판이 붙고, 그 밖의 물건은
    // 그대로 간다. "All" 은 헬멧의 야시경·마운트·바이저까지 붙인다.
    //
    // 바라는 답(이 설치본의 DB 로 실측한 것):
    //   IOTV(13칸)  → 아라미드 삽입물 9 + 방어판 4 = 13개
    //   AVS 리그     → 삽입물 3 + 방어판 2 = 5개
    //   FAST MT      → 삽입물 2 + 야시경 GPNVG-18 + 마운트 + 바이저 …
    //   SIG MCX      → Auto 라 아무것도 안 붙는다(무기는 건드리지 않는다)
    "aabbccdd0000000000000004": {
      "Icon": "Weapon",
      "Items": [
        { "Tpl": "5b44cd8b86f774503d30cba2", "Count": 1 },              // IOTV Gen4 완전형
        { "Tpl": "544a5caa4bdc2d1a388b4568", "Count": 1 },              // Crye AVS 플레이트 캐리어
        { "Tpl": "5a154d5cfcdbcb001a3b00da", "Count": 1, "Fill": "All" }, // Ops-Core FAST MT
        { "Tpl": "5a154d5cfcdbcb001a3b00da", "Count": 1, "Fill": "None" },// 같은 헬멧, 빈 몸
        { "Tpl": "5fbcc1d9016cce60e8341ab3", "Count": 1 }               // SIG MCX — 안 건드려야 한다
      ]
    },

    // 큰 상자 확인용. 보통 상자(120칸)에는 절대 안 들어가는 양을 넣는다.
    // 4×4 방탄복 20개 = 320칸 → 900칸 상자에서는 하나도 안 빠져야 한다.
    // (같은 품목을 120칸 상자에 넣는 …0002 는 "자리 없음" 이 나오는 쪽이다.)
    "aabbccdd0000000000000005": {
      "Icon": "Weapon",
      "BigCrate": true,
      "Items": [
        { "Tpl": "5b44cd8b86f774503d30cba2", "Count": 20, "Fill": "None" }
      ]
    },

    // 칸을 직접 고르는 것 확인용. 네 가지를 한꺼번에 본다.
    "aabbccdd0000000000000006": {
      "Icon": "Common",
      "Items": [
        {
          "Tpl": "5b44cd8b86f774503d30cba2", // IOTV Gen4 완전형
          "Slots": {
            // (ㄱ) 자동보다 **낮은** 것을 일부러 고른다. 자동은 7등급을 집지만
            //      적어 낸 쪽이 이겨야 하므로 6등급이 들어가야 한다.
            "Front_plate": "656faf0ca0dce000a2020f77", // GAC 4sss2 (6등급)

            // (ㄴ) 빈 문자열 = 비워 둬라. 자동이 채우는 것을 막는 유일한 방법이다.
            "Back_plate": "",

            // (ㄷ) 그 칸에 못 다는 것. 거절하고 "고친 것" 에 적혀야 한다.
            //      조용히 버리거나 조용히 다른 것을 넣으면 안 된다.
            "Left_side_plate": "5c0558060db834001b735271" // GPNVG-18 — 방탄판 칸에 야시경
          }
        },
        {
          // (ㄹ) 겹친 칸. Fill 이 None 인데도 직접 고른 자리까지는 길을 내줘야 한다.
          //      헬멧 → Norotos 마운트 → GPNVG-18 두 겹이 붙고, 나머지 칸은 비어야 한다.
          "Tpl": "5a154d5cfcdbcb001a3b00da", // Ops-Core FAST MT
          "Fill": "None",
          "Slots": {
            "mod_nvg": "5a16b8a9fcdbcb00165aa6ca",        // Norotos 티타늄 마운트
            "mod_nvg.mod_nvg": "5a16b93dfcdbcbcae6687261" // 그 위에 AN/PVS-14 도브테일 마운트
          }
        }
      ]
    }
  }
}
